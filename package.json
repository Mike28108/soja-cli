{
  "name": "soja-cli",
  "version": "0.6.0",
  "description": "Software Operations & Job Assistant",
  "author": "Enmauel.biz",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mike28108/soja-cli.git"
  },
  "homepage": "https://github.com/Mike28108/soja-cli#readme",
  "bugs": {
    "url": "https://github.com/Mike28108/soja-cli/issues"
  },
  "private": true,
  "type": "module",
  "bin": {
    "soja": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "cli",
    "tui",
    "tasks",
    "developer-tools"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.tsx",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/index.tsx dev migrate",
    "db:seed": "tsx src/cli/index.tsx dev seed",
    "db:reset": "tsx src/cli/index.tsx dev reset"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "ink": "7.1.1",
    "react": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
